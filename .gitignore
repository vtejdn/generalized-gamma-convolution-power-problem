# Python caches and bytecode.
__pycache__/
*.py[cod]

# The archived SD manuscript directories keep source only.  Ignore TeX build
# products while retaining LaTeX and BibTeX inputs at any depth.
/background/alpha-cauchy-sd/manuscripts/**
!/background/alpha-cauchy-sd/manuscripts/**/
!/background/alpha-cauchy-sd/manuscripts/**/*.tex
!/background/alpha-cauchy-sd/manuscripts/**/*.bib

# Active GGC manuscript: retain only TeX/BibTeX sources and source folders.
# In particular, local compilation products and generated PDFs stay untracked.
/manuscript/**
!/manuscript/**/
!/manuscript/**/*.tex
!/manuscript/**/*.bib
