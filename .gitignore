# Python caches and bytecode.
__pycache__/
*.py[cod]

# Active GGC manuscript: retain only TeX/BibTeX sources and source folders.
# In particular, local compilation products and generated PDFs stay untracked.
/manuscript/**
!/manuscript/**/
!/manuscript/**/*.tex
!/manuscript/**/*.bib

# Literature PDFs are local reading copies; keep only notes and metadata.
/literature/**/*.pdf
