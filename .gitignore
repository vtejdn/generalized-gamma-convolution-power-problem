# Ignore everything under version-GPT and version-Wang.
/version-GPT/**
/version-Wang/**

# Keep directories traversable so TeX and BibTeX sources can be re-included.
!/version-GPT/**/
!/version-Wang/**/

# Keep LaTeX sources and bibliography databases at any depth.
!/version-GPT/**/*.tex
!/version-GPT/**/*.bib
!/version-Wang/**/*.tex
!/version-Wang/**/*.bib
